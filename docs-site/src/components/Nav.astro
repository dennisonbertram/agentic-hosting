---
import { githubRepo, githubStar } from '../data/nav';

const base = import.meta.env.BASE_URL;
---

<nav class="sticky top-0 z-50 bg-stone-50/95 backdrop-blur border-b border-stone-200/70">
  <div class="flex items-center justify-between px-4 sm:px-6 py-3.5">
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="docs-menu-btn"
        class="lg:hidden w-8 h-8 rounded-md border border-stone-200 text-stone-700 flex items-center justify-center"
        aria-label="Open documentation menu"
        aria-expanded="false"
        aria-controls="docs-sidebar"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a href={base} class="flex items-center gap-2.5">
        <div class="w-7 h-7 bg-stone-900 rounded flex items-center justify-center flex-shrink-0">
          <span class="text-stone-50 font-bold text-xs font-mono-stack">ah</span>
        </div>
        <div>
          <div class="font-bold text-sm text-stone-900 tracking-wide leading-none">agentic.hosting</div>
          <div class="text-[10px] text-stone-500 leading-none mt-0.5">docs</div>
        </div>
      </a>
    </div>
    <div class="flex items-center gap-3 sm:gap-5">
      <a href="https://agentic.hosting" class="hidden sm:inline text-xs text-stone-600 hover:text-stone-900 transition-colors">Home</a>
      <a href={`${base}api/`} class="hidden md:inline text-xs text-stone-600 hover:text-stone-900 transition-colors">API</a>
      <a href={githubRepo} class="text-xs text-stone-600 hover:text-stone-900 transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub
      </a>
      <a
        href={githubStar}
        class="text-xs text-stone-50 bg-stone-900 rounded-full px-3 py-1.5 flex items-center gap-1.5 hover:opacity-90 transition-opacity"
      >
        ★ Star on GitHub
      </a>
    </div>
  </div>
</nav>
