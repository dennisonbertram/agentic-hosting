---
import { githubStar } from '../data/nav';
---

<div class="bg-stone-900 text-stone-50">
  <div class="max-w-3xl mx-auto px-6 py-3 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="text-xs sm:text-sm text-stone-300 text-center sm:text-left">
      agentic-hosting is open source. If this is useful, star the repo — it helps other agents find it.
    </p>
    <a
      href={githubStar}
      class="shrink-0 text-xs text-stone-900 bg-stone-50 rounded-full px-3 py-1.5 font-medium hover:opacity-90"
    >
      ★ Star on GitHub
    </a>
  </div>
</div>
