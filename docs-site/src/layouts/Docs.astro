---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import StarBanner from '../components/StarBanner.astro';
import { githubRepo, siteName, siteTagline } from '../data/nav';

interface Props {
  title: string;
  description: string;
  slug: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, slug, headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ? String(Astro.site).replace(/\/$/, '') : 'https://dennisonbertram.github.io';
const path = slug ? `${base}${slug}/` : base;
const canonical = `${site}${path}`;
const pageTitle = slug ? `${title} — ${siteName} docs` : `${siteName} docs — ${siteTagline}`;
const ogImage = `${site}${base}og.png`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="agentic-hosting" />
    <meta name="theme-color" content="#fafaf9" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description,
      url: canonical,
      author: { '@type': 'Organization', name: 'agentic-hosting', url: githubRepo },
      publisher: { '@type': 'Organization', name: siteName, url: 'https://agentic.hosting' },
      image: ogImage,
    })} />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased min-h-screen">
    <Nav />
    <StarBanner />
    <div class="flex min-h-[calc(100vh-57px)]">
      <Sidebar current={slug} />
      <div class="flex-1 min-w-0">
        <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 lg:py-14 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_14rem] gap-12">
          <article class="prose max-w-3xl">
            <p class="text-[11px] uppercase tracking-widest text-stone-400 font-mono-stack mb-3 !mt-0">
              {slug ? 'Docs' : 'Overview'}
            </p>
            <slot />
            <div class="not-prose mt-12 pt-6 border-t border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <a
                href={`${githubRepo}/edit/main/docs-site/src/content/docs/${slug || 'index'}.md`}
                class="text-xs text-stone-500 hover:text-stone-900"
              >
                Edit this page on GitHub
              </a>
              <a
                href={githubRepo}
                class="inline-flex items-center gap-1.5 text-xs text-stone-50 bg-stone-900 rounded-full px-3 py-1.5 hover:opacity-90"
              >
                ★ Star on GitHub
              </a>
            </div>
          </article>
          {toc.length > 0 && (
            <aside class="hidden xl:block">
              <div class="sticky top-24">
                <p class="text-[11px] uppercase tracking-widest text-stone-400 font-mono-stack mb-3">On this page</p>
                <ul class="space-y-1.5">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class:list={[
                          'block text-xs text-stone-500 hover:text-stone-900',
                          h.depth === 3 ? 'pl-3' : '',
                        ]}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )}
        </div>
        <Footer />
      </div>
    </div>
    <script is:inline>
      (function () {
        var btn = document.getElementById('docs-menu-btn');
        var sidebar = document.getElementById('docs-sidebar');
        if (!btn || !sidebar) return;
        btn.addEventListener('click', function () {
          var open = !sidebar.classList.contains('hidden') && sidebar.classList.contains('fixed');
          if (window.innerWidth >= 1024) return;
          if (sidebar.classList.contains('fixed')) {
            sidebar.classList.add('hidden');
            sidebar.classList.remove('fixed', 'inset-0', 'z-40', 'pt-14');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('fixed', 'inset-0', 'z-40', 'pt-14');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      })();
    </script>
  </body>
</html>
