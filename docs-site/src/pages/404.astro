---
import Docs from '../layouts/Docs.astro';
const base = import.meta.env.BASE_URL;
---

<Docs title="Page not found" description="That documentation page does not exist." slug="404">
  <h1>This page is not in the docs.</h1>
  <p>
    The URL may be wrong. Start at the
    <a href={base}>overview</a> or the <a href={`${base}api/`}>REST API</a>.
  </p>
</Docs>
